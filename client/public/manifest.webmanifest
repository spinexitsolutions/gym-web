{
  "name": "Aurum Fitness Club",
  "short_name": "Aurum",
  "description": "Premium gym — memberships, bookings, QR check-in and progress tracking.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0B0B0C",
  "theme_color": "#0B0B0C",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Check-in QR", "url": "/dashboard/check-in", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Book a session", "url": "/dashboard/book", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
