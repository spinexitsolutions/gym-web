# ---------------------------------------------------------------------------
# Apex Athletics API — copy to server/.env and fill in. Never commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Use a replica set (or MongoDB Atlas) so multi-document transactions are enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/apex_athletics?replicaSet=rs0
# Comma-separated browser origins allowed by CORS.
CLIENT_URL=http://localhost:5173
# Public URL used in emails, sitemap and canonical links.
PUBLIC_SITE_URL=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs / rate limits).
TRUST_PROXY=0
# Serve client/dist from the API (single-origin deployment).
SERVE_CLIENT=false
LOG_LEVEL=info

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS only cookies).
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
REQUIRE_EMAIL_VERIFICATION=false

# --- Payments -----------------------------------------------------------------
# razorpay | sandbox (local dev only, refused in production) | disabled
PAYMENT_PROVIDER=sandbox
# Razorpay test keys start with rzp_test_. Keep the secret on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ORDER_TTL_MIN=60

# --- Email (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST empty to log instead of sending (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Apex Athletics <no-reply@example.com>

# --- WhatsApp (optional, approved Business provider) -------------------------
# none | meta | twilio
WHATSAPP_PROVIDER=none
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TEMPLATE_LANG=en
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Media storage ------------------------------------------------------------
# local | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=apex-athletics
MAX_IMAGE_MB=8
MAX_MODEL_MB=15

# --- Jobs -------------------------------------------------------------------
JOBS_ENABLED=true

# --- Initial admin (used once by `npm run create-admin`, then remove) --------
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
