# ---------------------------------------------------------------
# Aurum Fitness Club API — copy to .env and fill in real values.
# Placeholders only. Never commit a real .env file.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public URL of the React app (CORS origin + links in emails). Comma-separate several.
CLIENT_URL=http://localhost:5173

# MongoDB (local, Docker or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aurum_gym

# JWT — use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7

# Set to true behind HTTPS in production (Secure cookies)
COOKIE_SECURE=false
# Optional cookie domain, e.g. .yourgym.com when API and site share a parent domain
COOKIE_DOMAIN=
# lax (same site, recommended) | strict | none (cross-site; needs COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# Cloudinary (image & video uploads). Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aurum-gym

# Razorpay (membership payments, Phase 5)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP via Nodemailer. Leave SMTP_HOST blank in development: emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aurum Fitness Club <no-reply@example.com>"

# Time zone used for attendance days, reminders and reports
GYM_TIMEZONE=Asia/Kolkata
# Optional GST number printed on invoices
INVOICE_GSTIN=

# Local testing without Razorpay keys: a sandbox gateway (never available when NODE_ENV=production)
PAYMENT_SANDBOX=true

# Optional web push notifications. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional AI fitness assistant (Anthropic API). Leave blank to disable the assistant.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Set true on extra API instances so scheduled jobs run on one server only (jobs also use a DB lock)
DISABLE_JOBS=false
